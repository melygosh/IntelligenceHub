# === Database ===
POSTGRES_USER=intelligencehub
POSTGRES_PASSWORD=replace_me_for_local
POSTGRES_DB=intelligencehub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Used by the api container; constructed from the above for local dev.
DATABASE_URL=postgres://intelligencehub:replace_me_for_local@postgres:5432/intelligencehub

# === Redis (wired Day 1, used from Day 2 for BullMQ) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# === Auth / JWT ===
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_me_with_random_32_bytes_minimum
JWT_EXPIRES_IN=7d

# === Bull Board (basic-auth for /admin/queues, used from Day 2) ===
BULL_BOARD_USER=admin
BULL_BOARD_PASS=replace_me

# === LLM providers (used from Phase 2 Day 5 onward) ===
LLM_PROVIDER=openai
# Optional: enable LLM provider failover. After the primary's retry exhausts,
# the request retries once on this secondary. Must differ from LLM_PROVIDER;
# both API keys must be set. Leave unset to disable failover.
# LLM_FALLBACK_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_OPENAI=gpt-4o-mini
LLM_MODEL_ANTHROPIC=claude-haiku-4-5
LLM_CONCURRENCY=2
LLM_TOKEN_LIMIT_PER_ARTICLE=4000

# === Workers (used from Phase 2 onward) ===
FEED_PULL_INTERVAL_SECONDS=900

# === App ===
APP_DEV_MODE=true
# Backend base URL on the host (used for cookie domain in prod, log links in dev mode).
# Host port is 3010 to avoid clashing with other dev servers commonly running on
# 3000/3005. The container listens on 3011 (also avoided on the dev host), so inside
# the docker network services reach the api at http://api:3011.
APP_BASE_URL=http://localhost:3010
# Frontend base URL on the host (used by backend CORS allowlist).
# Host port is 5174 (not 5173) to avoid clashing with a local Vite dev server on 5173.
WEB_BASE_URL=http://localhost:5174

# === API port (inside container) ===
API_PORT=3011

# === Heuristic pre-filter (Phase 2 Day 4) ===
# Deterministic rejection layer that runs BEFORE any LLM call. Each check can be
# toggled off; thresholds are tunable. All optional — sensible defaults shown.
#
# Minimum article body length (chars). Articles below this are stored
# status='filtered', filter_reason='too_short', no LLM call.
PREFILTER_MIN_LENGTH=200
# Per-check switches (true/false):
PREFILTER_EMPTY_ENABLED=true              # drop empty title or body
PREFILTER_MIN_LENGTH_ENABLED=true         # drop bodies under PREFILTER_MIN_LENGTH
PREFILTER_SPAM_TITLE_RATIO_ENABLED=true   # drop when title is too large vs body (SEO stub)
PREFILTER_SPAM_LINK_DENSITY_ENABLED=true  # drop link-farm bodies
# Spam thresholds, as a fraction of body length (0..1):
PREFILTER_TITLE_RATIO=0.5                  # title longer than this fraction of body → spam
PREFILTER_LINK_DENSITY_RATIO=0.5           # anchor text longer than this fraction of body → spam
