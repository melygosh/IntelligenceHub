# === Database ===
POSTGRES_USER=intelligencehub
POSTGRES_PASSWORD=replace_me_for_local
POSTGRES_DB=intelligencehub
POSTGRES_HOST=postgres
# Used by the api/worker containers. This is a LITERAL connection string, NOT
# derived from the POSTGRES_* vars above — if you change the user / password /
# db, edit it here to match. Host `postgres` + :5432 are the in-network service
# name and port (use localhost:5433 when connecting from the host).
DATABASE_URL=postgres://intelligencehub:replace_me_for_local@postgres:5432/intelligencehub

# === Redis (wired Day 1, used from Day 2 for BullMQ) ===
REDIS_HOST=redis
REDIS_URL=redis://redis:6379

# === Auth / JWT ===
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_me_with_random_32_bytes_minimum
JWT_EXPIRES_IN=7d

# === Bull Board (basic-auth for /admin/queues, used from Day 2) ===
BULL_BOARD_USER=admin
BULL_BOARD_PASS=replace_me

# === LLM providers (used from Phase 2 Day 5 onward) ===
# Role-based config: one trio for the primary, one trio for the (optional)
# fallback. Switching primary requires updating all three primary lines
# together (you can't keep both provider keys around to flip via LLM_PROVIDER).
LLM_PROVIDER=anthropic
# LLM_PROVIDER_MODEL left blank → default per provider:
#   anthropic → claude-haiku-4-5     openai → gpt-4o-mini
LLM_PROVIDER_MODEL=
LLM_PROVIDER_API_KEY=
# Optional fallback. When LLM_FALLBACK_PROVIDER is set, the primary's retry
# exhausts → one extra attempt on this secondary. Must differ from
# LLM_PROVIDER; the fallback's API key is required. Leave unset to disable.
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_PROVIDER_MODEL=
# LLM_FALLBACK_PROVIDER_API_KEY=
LLM_CONCURRENCY=2
LLM_TOKEN_LIMIT_PER_ARTICLE=4000
# Max characters for the article summary (drives the analyze prompt + output schema).
SUMMARY_MAX_CHARS=800
# Output-token cap for digest generation (short title + 2-3 bullets).
LLM_TOKEN_LIMIT_PER_DIGEST=1024
# Digest length = number of editorial paragraphs (min/max).
DIGEST_MIN_PARAGRAPHS=2
DIGEST_MAX_PARAGRAPHS=3
# Per-request timeout (ms) for both LLM adapters. Bounds a hung provider so it
# can't hold an LLM_CONCURRENCY slot for the SDK's ~10-minute default; on
# timeout the call hands off to failover (if set) or the BullMQ job retry.
LLM_TIMEOUT_MS=60000

# === Article-analyze queue (async LLM analysis) ===
# Each new/pending article is analyzed by a BullMQ job. On failure the job
# retries with a fixed backoff, sitting in the queue's `delayed` set between
# attempts (watch it in Bull Board → article.analyze); after the attempt
# budget is spent the article is marked terminally 'failed'.
#
# Max attempts before giving up (transient LLM outages recover well within this):
ANALYZE_MAX_ATTEMPTS=20
# Fixed delay between attempts, in seconds (fixed, not exponential, so a
# recovered provider drains the backlog promptly):
ANALYZE_BACKOFF_SECONDS=60
# How many analyze jobs run concurrently (the LLM_CONCURRENCY semaphore is the
# real LLM rate gate; this just bounds how many jobs show as `active`):
ANALYZE_CONCURRENCY=2

# === Feed pull queue (RSS ingestion) ===
# A single repeatable "sweep" job (driven by FEED_PULL_CRON) fans out a pull
# for every active feed across all users — this is the scheduled ingestion
# path that runs without a request context. Manual "Pull now" / "Pull all"
# from the UI enqueue the same per-feed jobs. Overlapping enqueues for the
# same (user, feed) are deduplicated while a pull is still in flight, so a
# tick that lands on a feed still pulling from the previous tick is skipped.
#
# 6-field cron (seconds minutes hours dom month dow); default every 15 min.
# Leave empty to disable the schedule (manual pulls still work):
FEED_PULL_CRON=0 */15 * * * *
# How many feeds are fetched in parallel. Network-bound; independent of
# LLM_CONCURRENCY (which gates the downstream LLM calls), so raising this
# does not affect LLM cost. Default 1 (serial) keeps cross-source dedup exact:
# parallel pulls of the same story could interleave their dedup check and
# under-count the "N similar" counter. Raise it for faster sweeps if you
# accept that rare race (real duplicates are still prevented):
FEED_PULL_CONCURRENCY=1
# Redis read-through cache TTL (seconds) for a fetched+parsed feed, keyed by URL.
# A feed subscribed by N users is fetched once per sweep instead of N times.
# Keep it well below the sweep interval (default 120s « the 15-min cron); 0 disables.
FEED_FETCH_CACHE_TTL_SECONDS=120
# After this many consecutive failed pulls a feed is auto-disabled (dropped from
# the sweep). A success or manual re-activate resets the counter.
FEED_GIVE_UP_AFTER_FAILURES=10

# === App ===
APP_DEV_MODE=true
# Backend base URL on the host (used for cookie domain in prod, log links in dev mode).
# Host port is 3010 to avoid clashing with other dev servers commonly running on
# 3000/3005. The container listens on 3011 (also avoided on the dev host), so inside
# the docker network services reach the api at http://api:3011.
APP_BASE_URL=http://localhost:3010
# Frontend base URL on the host (used by backend CORS allowlist).
# Host port is 5174 (not 5173) to avoid clashing with a local Vite dev server on 5173.
WEB_BASE_URL=http://localhost:5174

# === API port (inside container) ===
API_PORT=3011

# === Process role: all | api | worker ===
# 'all' (default) runs HTTP + BullMQ workers in one process — fine for native
# `pnpm dev`. docker compose overrides this per-service: the `api` service runs
# 'api' (HTTP only) and the `worker` service runs 'worker' (consumers only), so
# you do NOT need to set this in .env. Left here for documentation / native use.
APP_ROLE=all

# === Heuristic pre-filter (Phase 2 Day 4) ===
# Deterministic rejection layer that runs BEFORE any LLM call. Each check can be
# toggled off; thresholds are tunable. All optional — sensible defaults shown.
#
# Minimum article body length (chars). Articles below this are stored
# status='filtered', filter_reason='too_short', no LLM call.
PREFILTER_MIN_LENGTH=200
# Per-check switches (true/false):
PREFILTER_EMPTY_ENABLED=true              # drop empty title or body
PREFILTER_MIN_LENGTH_ENABLED=true         # drop bodies under PREFILTER_MIN_LENGTH
PREFILTER_SPAM_TITLE_RATIO_ENABLED=true   # drop when title is too large vs body (SEO stub)
PREFILTER_SPAM_LINK_DENSITY_ENABLED=true  # drop link-farm bodies
# Spam thresholds, as a fraction of body length (0..1):
PREFILTER_TITLE_RATIO=0.5                  # title longer than this fraction of body → spam
PREFILTER_LINK_DENSITY_RATIO=0.5           # anchor text longer than this fraction of body → spam

# === Digest builder ===
# Max articles fed to the LLM for the prose summary of a single digest. The
# deterministic aggregations (top entities / categories / key articles) still
# run over every in-scope article; only the summary prompt is capped, by
# importance then recency. Keeps a wide "month" digest's prompt + cost bounded.
DIGEST_MAX_LLM_ARTICLES=40

# === Graph customize-canvas selection cap ===
# Upper bound on the explicit entityIds / articleIds list length the
# customize-canvas side panel can send per kind. Surfaced to the frontend
# via GET /api/config so the picker can disable selection past the cap.
GRAPH_SELECTION_CAP=100

# === Graph similar-edge density cap ===
# Max `similar` (article↔article) edges kept per displayed article node when
# semantic similarity is on, so the canvas doesn't hairball and dagre layout
# stays responsive.
GRAPH_SIMILAR_EDGES_PER_NODE=3

# === Semantic similarity (ADR-7, FR-5 Could-tier bonus) ===
# Self-contained config — separate provider/model/key from LLM_* so the
# embed cost lens is independent. Off by default; opt in explicitly:
#   1. flip ENABLED to true
#   2. set SEMANTIC_SIMILARITY_API_KEY
# When false (default): no embeddings, no extra cost, deterministic dedup
# keeps working, the "Related (semantic)" UI section stays hidden.
SEMANTIC_SIMILARITY_ENABLED=false
SEMANTIC_SIMILARITY_PROVIDER=openai
SEMANTIC_SIMILARITY_MODEL=text-embedding-3-small
SEMANTIC_SIMILARITY_API_KEY=
# Cosine similarity threshold for "related" — values below this stay
# hidden. Range [-1, 1]; 0.85 surfaces only meaningfully-related copies.
SEMANTIC_SIMILARITY_THRESHOLD=0.85
