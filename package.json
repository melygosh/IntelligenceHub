{
  "name": "intelligencehub",
  "version": "0.1.0",
  "private": true,
  "description": "News Intelligence Hub — UA-Skills tournament submission",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "gts": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
